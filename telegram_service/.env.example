TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./telegram

# One chat: TELEGRAM_SOURCE_CHAT_ID=-100xxxxxxxxxx
# Several chats (comma-separated, no spaces required):
TELEGRAM_SOURCE_CHAT_IDS=-1001756020315,-1001429269676,-1001267214144,-1001992318151

# Firebase Admin JSON — full path, forward slashes OK on Windows. Same project as the Flutter app.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/pal48checkpoint-firebase-adminsdk-xxxxx.json
GOOGLE_APPLICATION_CREDENTIALS=
